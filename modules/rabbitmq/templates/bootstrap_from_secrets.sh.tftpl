#!/bin/bash
set -euo pipefail

TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
REGION=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/dynamic/instance-identity/document | jq -r '.region')

dnf -y update
# amazon-linux-extras may not exist on all AMIs; ignore if missing
(amazon-linux-extras enable rabbitmq3.8 || true)
dnf -y install rabbitmq-server jq awscli
systemctl enable --now rabbitmq-server
rabbitmq-plugins enable rabbitmq_management

ADMIN_SECRET='${rabbitmq_admin_credentials_secret_arn}'
APP_SECRET='${rabbitmq_app_credentials_secret_arn}'
APP_TAGS='${rabbitmq_app_user_tags}'

ADMIN_JSON=$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "$ADMIN_SECRET" --query SecretString --output text)
APP_JSON=$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "$APP_SECRET" --query SecretString --output text)

ADMIN_USER=$(echo "$ADMIN_JSON" | jq -r '.username')
ADMIN_PASS=$(echo "$ADMIN_JSON" | jq -r '.password')
APP_USER=$(echo "$APP_JSON" | jq -r '.username')
APP_PASS=$(echo "$APP_JSON" | jq -r '.password')

if rabbitmqctl list_users | awk '{print $1}' | grep -qx "$ADMIN_USER"; then
  rabbitmqctl change_password "$ADMIN_USER" "$ADMIN_PASS"
else
  rabbitmqctl add_user "$ADMIN_USER" "$ADMIN_PASS"
fi
rabbitmqctl set_user_tags "$ADMIN_USER" administrator
rabbitmqctl set_permissions -p / "$ADMIN_USER" ".*" ".*" ".*"

if rabbitmqctl list_users | awk '{print $1}' | grep -qx "$APP_USER"; then
  rabbitmqctl change_password "$APP_USER" "$APP_PASS"
else
  rabbitmqctl add_user "$APP_USER" "$APP_PASS"
fi
rabbitmqctl set_user_tags "$APP_USER" "$APP_TAGS"
rabbitmqctl set_permissions -p / "$APP_USER" ".*" ".*" ".*"

# Disable default guest account for safety when present.
if rabbitmqctl list_users | awk '{print $1}' | grep -qx "guest"; then
  rabbitmqctl delete_user guest || true
fi
